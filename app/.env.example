# Copy this file to .env.local and fill in real values.
# Never commit .env or .env.local — see .gitignore.

NODE_ENV=development

# MongoDB connection string (local or Atlas). Required.
MONGODB_URI=mongodb://localhost:27017/fruitland_dev

# --- Auth (see docs/auth.md) ---
# Required. Use a long random string in every real environment — never reuse
# the placeholder below outside local dev.
JWT_ACCESS_SECRET=change-me-dev-only-access-secret
JWT_REFRESH_SECRET=change-me-dev-only-refresh-secret
# Defaults shown match the values proven in the legacy system; override only if approved.
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN_DAYS=30
# OTP_LENGTH=4
# OTP_EXPIRES_IN_SECONDS=120
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_REQUESTS_PER_HOUR=5
# OTP_MAX_VERIFY_ATTEMPTS=5
# OTP_LOCK_MINUTES_AFTER_MAX_ATTEMPTS=15
# PASSWORD_HASH_ROUNDS=10
# PASSWORD_MAX_FAILED_ATTEMPTS=5
# PASSWORD_LOCK_MINUTES=15

# "console" (default) logs the OTP code instead of sending it — dev/test
# only, refused at startup when NODE_ENV=production. Set to a real provider
# once one is chosen and its adapter is implemented.
SMS_PROVIDER=console
# production: SMS_PROVIDER=smsir  (نیازمند دو متغیر زیر؛ متن Template در پنل sms.ir باید متغیر #Code# داشته باشد)
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=

# --- External services (added when their adapter is implemented) ---
# CLOUDINARY_URL=
# ZARINPAL_MERCHANT_ID=
# NESHAN_API_KEY=
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=

# ── Maps (Phase 4.5) ──
# Active service provider (validated: must be exactly one of these three, or startup fails).
# Only the credential for the SELECTED provider is required.
MAP_PROVIDER=neshan
# Neshan: server key (Api-Key header). Must be the "Web Service" key type, NOT the "Web Map" rendering key (see CLAUDE.md).
NESHAN_API_KEY=
# Only needed if you set MAP_PROVIDER to one of these, or later for Comparison Mode
# Map.ir: one credential covers both the REST API (x-api-key) and the Web SDK
MAPIR_API_KEY=
# Google: server-side key with Geocoding API, Places API (New) and Routes API enabled.
# Do NOT reuse this for browser map rendering — Google recommends a separate key
# with different restrictions (server: IP restriction; browser: HTTP referrer) for that.
GOOGLE_MAPS_API_KEY=
# Optional tuning (defaults are used when empty)
# Optional. Same three values as MAP_PROVIDER, or leave empty for no fallback.
# Used by MapService only for TIMEOUT/NETWORK/PROVIDER_UNAVAILABLE — never for
# auth or validation errors. A value equal to MAP_PROVIDER is treated as "no fallback".
MAP_FALLBACK_PROVIDER=
MAP_ENABLE_COMPARISON=false
MAP_ENABLE_ROUTE_MATRIX=false
MAP_REQUEST_TIMEOUT_MS=10000
# Extra attempts AFTER the first try, against the same provider, for retryable errors only.
MAP_MAX_RETRIES=2
MAP_CACHE_ENABLED=true
MAP_CACHE_TTL_SECONDS=86400
